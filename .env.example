# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (used by docker-compose and the backend) ---
POSTGRES_USER=bfr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bhutanese_food
POSTGRES_PORT=5432
# 127.0.0.1, not localhost: the container listens on IPv4 only, and localhost tries IPv6 first
DATABASE_URL=postgresql+psycopg://bfr:change-me@127.0.0.1:5432/bhutanese_food

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# --- App ---
CORS_ORIGINS=http://localhost:5173
# Set to true when the app is served over HTTPS so the session cookie is never sent in clear
COOKIE_SECURE=false
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Below this confidence the UI says "not sure, try another photo"
CONFIDENCE_THRESHOLD=0.6
# Path to the trained .keras model; leave empty to use the placeholder predictor
MODEL_PATH=

# --- Demo account created by `python -m scripts.seed` ---
SEED_USER_NAME=Dorji
SEED_USER_EMAIL=demo@druklens.bt
SEED_USER_PASSWORD=change-me

# --- Admin account created by `python -m scripts.seed` (sees all users, scans and feedback) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@druklens.bt
SEED_ADMIN_PASSWORD=change-me
